DRY_RUN=false
APP_MODE=live
PROVIDER=serpapi
LOG_LEVEL=INFO
SKIP_RC_IMPORT=false

SERPAPI_API_KEY=
SERPAPI_MAX_PAGES=3

SCRAPE_CITY=Vilnius
SCRAPE_CATEGORIES=food,beauty,cars
MAX_CATEGORIES=3

MAP_LATITUDE=54.6872
MAP_LONGITUDE=25.2797
MAP_ZOOM=14
MAP_LANGUAGE=lt
MAP_COUNTRY=lt

REQUEST_DELAY_SECONDS=2
MAX_WEBSITES_TO_CHECK=30

DATABASE_PATH=data/shadow_economy.sqlite
REPORT_OUTPUT_PATH=data/reports/final_report.csv
SAMPLE_GOOGLE_MAPS_PATH=data/sample/sample_google_maps_response.json

# Single-file RC import
RC_CSV_PATH=data/raw_external/rc_financials.csv

# Optional multi-file RC import.
# If set, importer reads all .csv files from this folder.
RC_CSV_DIR=data/raw_external/rc